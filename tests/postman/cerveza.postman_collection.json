    {
      "name": "beers",
      "item": [
        {
          "name": "POST BEER [admin]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Validar estructura del producto creado\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"status\", \"success\");\n    pm.expect(jsonData).to.have.property(\"data\");\n    pm.expect(jsonData.data).to.have.property(\"name\");\n    pm.expect(jsonData.data).to.have.property(\"_id\");\n});\n\npm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "{{$randomAlphaNumeric}}",
                  "type": "text"
                },
                {
